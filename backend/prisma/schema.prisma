generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FACULTY
  STUDENT
}

enum DurationType {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum InquiryStatus {
  NEW
  FOLLOW_UP
  INTERESTED
  ADMISSION_DONE
  NOT_INTERESTED
  CLOSED
}

enum AdmissionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  DROPPED
  TRANSFERRED
  REVISION
}

enum StudentCategory {
  SCHOOL
  COLLEGE
  WORKING
  PROFESSIONAL
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  SPOUSE
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  BANK
  OTHER
}

enum DocumentType {
  PHOTO
  AADHAAR
  PAN
  MARKSHEET_10
  MARKSHEET_12
  GRADUATION
  ADDRESS_PROOF
  OTHER
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  password          String
  role              Role              @default(STUDENT)
  isActive          Boolean           @default(true)
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedInquiries Inquiry[]         @relation("InquiryAssignedUser")
  inquiryFollowUps  InquiryFollowUp[] @relation("InquiryFollowUpCreatedBy")
  student           Student?
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  category     String?      @default("IT Course")
  departmentId String?
  description  String?
  duration     Int
  durationType DurationType
  fees         Decimal      @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  department   Department?  @relation(fields: [departmentId], references: [id])
  inquiries    Inquiry[]
  admissions   Admission[]

  @@index([departmentId])
}

model LeadSource {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]
}

model Inquiry {
  id               String            @id @default(cuid())
  inquiryNumber    String            @unique
  fullName         String
  mobile           String
  whatsapp         String?
  gender           String
  email            String?
  remarks          String?
  expectedFees     Decimal           @db.Decimal(10, 2)
  inquiryDate      DateTime          @default(now())
  nextFollowUpDate DateTime
  lastContactDate  DateTime?
  status           InquiryStatus     @default(NEW)
  courseId         String
  leadSourceId     String
  assignedToId     String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  course           Course            @relation(fields: [courseId], references: [id])
  leadSource       LeadSource        @relation(fields: [leadSourceId], references: [id])
  assignedTo       User              @relation("InquiryAssignedUser", fields: [assignedToId], references: [id])
  followUps        InquiryFollowUp[]
  admission        Admission?

  @@index([courseId])
  @@index([leadSourceId])
  @@index([assignedToId])
  @@index([status])
  @@index([nextFollowUpDate])
  @@index([isActive])
}

model InquiryFollowUp {
  id               String   @id @default(cuid())
  inquiryId        String
  followUpDate     DateTime
  remarks          String
  nextFollowUpDate DateTime?
  createdById      String
  createdAt        DateTime @default(now())
  inquiry          Inquiry  @relation(fields: [inquiryId], references: [id])
  createdBy        User     @relation("InquiryFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([inquiryId])
  @@index([createdById])
  @@index([followUpDate])
}

model Sequence {
  id           String   @id @default(cuid())
  name         String   @unique
  currentValue Int      @default(0)
  instituteId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([instituteId])
}

model Admission {
  id                 String             @id @default(cuid())
  admissionNumber    String             @unique
  inquiryId          String             @unique
  studentId          String?            @unique
  courseId           String
  batchId            String?
  courseNameSnapshot String
  courseFeesSnapshot Decimal            @db.Decimal(10, 2)
  admissionDate      DateTime           @default(now())
  admissionYear      String
  courseFees         Decimal            @db.Decimal(10, 2)
  discount           Decimal            @default(0.00) @db.Decimal(10, 2)
  finalFees          Decimal            @db.Decimal(10, 2)
  paidAmount         Decimal            @default(0.00) @db.Decimal(10, 2)
  pendingAmount      Decimal            @db.Decimal(10, 2)
  remarks            String?
  referredBy         String?
  studentCategory    StudentCategory
  guardianName       String
  guardianMobile     String
  guardianRelation   GuardianRelation
  status             AdmissionStatus    @default(ACTIVE)
  admittedBy         String
  updatedBy          String?
  deletedAt          DateTime?
  instituteId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  inquiry            Inquiry            @relation(fields: [inquiryId], references: [id])
  course             Course             @relation(fields: [courseId], references: [id])
  student            Student?
  payments           AdmissionPayment[]

  @@index([admissionNumber])
  @@index([inquiryId])
  @@index([studentId])
  @@index([courseId])
  @@index([batchId])
  @@index([status])
  @@index([admissionDate])
  @@index([admissionYear])
  @@index([deletedAt])
  @@index([instituteId])
}

model AdmissionPayment {
  id                   String      @id @default(cuid())
  admissionId          String
  amount               Decimal     @db.Decimal(10, 2)
  paymentMode          PaymentMode
  transactionReference String?
  paymentDate          DateTime    @default(now())
  remarks              String?
  instituteId          String?
  createdAt            DateTime    @default(now())
  admission            Admission   @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([paymentMode])
  @@index([paymentDate])
  @@index([createdAt])
  @@index([instituteId])
}

model Student {
  id               String            @id @default(cuid())
  studentId        String            @unique
  userId           String?           @unique
  admissionId      String            @unique
  fullName         String
  fatherName       String?
  motherName       String?
  gender           String
  dob              DateTime?
  mobile           String
  whatsapp         String?
  email            String?
  address          String?
  area             String?
  city             String?
  state            String?
  country          String?           @default("India")
  pincode          String?
  qualification    String?
  schoolCollege    String?
  bloodGroup       String?
  aadhaarNumber    String?
  joinedDate       DateTime          @default(now())
  leftDate         DateTime?
  status           StudentStatus     @default(ACTIVE)
  profileCompleted Boolean           @default(false)
  completionDate   DateTime?
  isCertificateEligible Boolean        @default(false)
  certificateUrl   String?
  certificateFileName String?
  certificateUploadedAt DateTime?
  deletedAt        DateTime?
  instituteId      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  admission        Admission         @relation(fields: [admissionId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  documents        StudentDocument[]
  attendances      Attendance[]

  @@index([studentId])
  @@index([admissionId])
  @@index([userId])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([joinedDate])
  @@index([deletedAt])
  @@index([instituteId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  NO_CLASS
  HOLIDAY
  EXEMPTED
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  markedBy  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([status])
}

model StudentDocument {
  id             String       @id @default(cuid())
  studentId      String
  documentType   DocumentType
  documentNumber String?
  fileName       String
  fileUrl        String
  mimeType       String
  fileSize       Int
  issueDate      DateTime?
  expiryDate     DateTime?
  isRequired     Boolean      @default(false)
  verified       Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  rejectedReason String?
  uploadedBy     String
  remarks        String?
  instituteId    String?
  createdAt      DateTime     @default(now())
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([documentType])
  @@index([verified])
  @@index([createdAt])
  @@index([instituteId])
}

model ExpenseCategory {
  id                String             @id @default(cuid())
  name              String             @unique
  type              String?            @default("EXPENSE")
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
}

model ExpenseParty {
  id                 String                     @id @default(cuid())
  name               String
  contactPerson      String?
  mobile             String?
  email              String?
  address            String?
  notes              String?
  status             String                     @default("ACTIVE")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  recurringInstances RecurringExpenseInstance[]

  @@index([name])
  @@index([status])
}

model Expense {
  id                  String                    @id @default(cuid())
  expenseNumber       String?                   @unique
  title               String
  amount              Float
  expenseDate         DateTime                  @default(now())
  paymentMode         PaymentMode               @default(CASH)
  categoryId          String?
  partyId             String?
  paidTo              String?
  referenceNumber     String?
  remarks             String?
  receiptUrl          String?
  createdBy           String?
  updatedBy           String?
  recurringExpenseId  String?
  recurringInstanceId String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  category            ExpenseCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  party               ExpenseParty?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  recurringExpense    RecurringExpense?         @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringInstance   RecurringExpenseInstance? @relation(fields: [recurringInstanceId], references: [id], onDelete: SetNull)

  @@index([expenseNumber])
  @@index([expenseDate])
  @@index([paymentMode])
  @@index([categoryId])
  @@index([partyId])
}

model RecurringExpense {
  id           String                     @id @default(cuid())
  title        String
  amount       Float
  paymentMode  PaymentMode                @default(CASH)
  frequency    String                     // DAILY, WEEKLY, MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  startDate    DateTime
  endDate      DateTime?
  nextDueDate  DateTime
  reminderDays Int                        @default(3)
  description  String?
  status       String                     @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  categoryId   String?
  partyId      String?
  createdBy    String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  category     ExpenseCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  party        ExpenseParty?              @relation(fields: [partyId], references: [id], onDelete: SetNull)
  instances    RecurringExpenseInstance[]
  expenses     Expense[]

  @@index([status])
  @@index([nextDueDate])
  @@index([categoryId])
  @@index([partyId])
}

model RecurringExpenseInstance {
  id                 String           @id @default(cuid())
  recurringExpenseId String
  dueDate            DateTime
  amount             Float
  status             String           @default("UPCOMING") // UPCOMING, DUE, OVERDUE, PAID
  paidDate           DateTime?
  partyId            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  party              ExpenseParty?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  expense            Expense?

  @@index([recurringExpenseId])
  @@index([dueDate])
  @@index([status])
}

enum NotificationType {
  NEW_INQUIRY
  NEW_STUDENT
  STUDENT_BIRTHDAY
  FEE_DUE
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType @default(SYSTEM)
  link        String?
  isRead      Boolean          @default(false)
  recipientId String?
  createdAt   DateTime         @default(now())

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

